# Global Window & Layout Settings
[global]
monitor = 0
width = (340, 460)
height = (60, 220)
offset = 16x56
origin = top-right
gap_size = 12

# Generous internal padding characteristic of M3 surfaces
padding = 18
horizontal_padding = 20
text_icon_padding = 18

# Expressive deep corner curvature & tonal borders
corner_radius = 24
frame_width = 1
separator_height = 0
line_height = 4

idle_threshold = 0
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

# Typography & Icon Rendering
font = "JetBrainsMono Nerd Font 11"
markup = full
format = "<span size='115%' weight='bold'>%s</span>\n<span alpha='80%'>%b</span>"
alignment = left
vertical_alignment = center
show_age_threshold = 60
ellipsize = end
ignore_newline = false
stack_duplicates = true
hide_duplicate_count = false

# Icon styling
icon_position = left
min_icon_size = 32
max_icon_size = 48
icon_theme = "Papirus-Dark"
icon_corner_radius = 12

# Progress Bar Settings (M3 Pill Indicator)
progress_bar = true
progress_bar_height = 8
progress_bar_frame_width = 0
progress_bar_corner_radius = 9999
progress_bar_min_width = 240
progress_bar_max_width = 380

# Urgency Levels & MD3 Tonal Palettes

# Low Urgency (M3 Surface Variant / Outline)
[urgency_low]
background = "#1d1f27"
foreground = "#c7c6d0"
frame_color = "#46464f"
highlight = "#79747e"
timeout = 4

# Normal Urgency (M3 Primary Container / Accent)
[urgency_normal]
background = "#14171f"
foreground = "#e3e2ea"
frame_color = "#2b303c"
highlight = "#a8c7fa"
timeout = 8

# Critical Urgency (M3 Error Container / Error Tone)
[urgency_critical]
background = "#2b1417"
foreground = "#f9dedc"
frame_color = "#8c1d18"
highlight = "#f2b8b5"
timeout = 0

# Audio & Event Triggers
[play_sound]
summary = "*"
script = ~/.config/dunst/notify_sound.sh
